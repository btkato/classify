generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum MembershipType {
  DROP_IN
  CLASS_PACK_5
  CLASS_PACK_10
  MONTHLY
  CONTINUOUS_MONTHLY
  YEARLY
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  EXHAUSTED
  PAUSED
  CANCELLED
}

enum ClassStatus {
  DRAFT
  ACTIVE
  CANCELLED
  COMPLETED
}

enum RegistrationStatus {
  ENROLLED
  WAITLISTED
  CANCELLED
  ATTENDED
  ABSENT
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum TriggerEvent {
  MEMBERSHIP_EXPIRING
  MEMBERSHIP_EXPIRED
  MEMBERSHIP_EXHAUSTED
  AFTER_CLASS_ATTENDED
  CLASS_COUNT_REACHED
  DAYS_INACTIVE
  AFTER_PURCHASE
}

model User {
  id          String    @id @default(uuid())
  email       String    @unique
  firstName   String
  lastName     String
  dateOfBirth  DateTime?
  phone        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  roles             UserRole[]
  instructorProfile InstructorProfile?
  memberships       Membership[]
  registrations     Registration[]
  taughtClasses     Class[]            @relation("InstructorClasses")
  announcements     Announcement[]     @relation("InstructorAnnouncements")
  notificationJobs  NotificationJob[]
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  role      Role
  grantedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
}

model InstructorProfile {
  userId    String   @id
  bio       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  certifications InstructorCertification[]
}

model Certification {
  id                   String   @id @default(uuid())
  name                 String   @unique
  validityPeriodMonths Int
  createdAt            DateTime @default(now())

  instructorCertifications InstructorCertification[]
}

model InstructorCertification {
  id              String   @id @default(uuid())
  instructorId    String
  certificationId String
  issuedAt        DateTime
  expiresAt       DateTime

  instructorProfile InstructorProfile @relation(fields: [instructorId], references: [userId])
  certification     Certification     @relation(fields: [certificationId], references: [id])

  @@unique([instructorId, certificationId])
  @@index([instructorId])
}

model Membership {
  id               String           @id @default(uuid())
  userId           String
  type             MembershipType
  status           MembershipStatus
  expiresAt        DateTime?
  classesRemaining Int?
  classesTotal     Int?
  priority         Int              @default(2)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user                   User                    @relation(fields: [userId], references: [id])
  membershipTransactions MembershipTransaction[]
  registrations          Registration[]
  notificationJobs       NotificationJob[]
}

model MembershipTransaction {
  id             String   @id @default(uuid())
  membershipId   String
  registrationId String?
  delta          Int
  balanceAfter   Int
  note           String?
  createdAt      DateTime @default(now())

  membership   Membership    @relation(fields: [membershipId], references: [id])
  registration Registration? @relation(fields: [registrationId], references: [id])

  @@index([membershipId])
  @@index([registrationId])
}

model Class {
  id               String      @id @default(uuid())
  instructorId     String
  categoryId       String
  title            String
  description      String?
  capacity         Int
  startsAt         DateTime
  durationMinutes  Int
  status           ClassStatus @default(DRAFT)
  location         String?
  recurringGroupId String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  instructor    User           @relation("InstructorClasses", fields: [instructorId], references: [id])
  category      ClassCategory  @relation(fields: [categoryId], references: [id])
  registrations Registration[]
  announcements Announcement[]

  @@index([instructorId])
  @@index([status])
  @@index([status, startsAt])
}

model ClassCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  classes Class[]
}

model Registration {
  id               String             @id @default(uuid())
  userId           String
  classId          String
  membershipId     String?
  status           RegistrationStatus
  waitlistPosition Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user                  User                    @relation(fields: [userId], references: [id])
  class                 Class                   @relation(fields: [classId], references: [id])
  membership            Membership?             @relation(fields: [membershipId], references: [id])
  membershipTransaction MembershipTransaction[]

  @@unique([userId, classId])
  @@index([userId])
  @@index([classId])
  @@index([classId, waitlistPosition])
}

model Announcement {
  id           String   @id @default(uuid())
  classId      String
  instructorId String
  body         String
  sentAt       DateTime @default(now())

  class      Class @relation(fields: [classId], references: [id])
  instructor User  @relation("InstructorAnnouncements", fields: [instructorId], references: [id])

  @@index([classId])
}

model NotificationJob {
  id           String             @id @default(uuid())
  userId       String
  membershipId String?
  triggerId    String
  status       NotificationStatus @default(PENDING)
  triggerAt    DateTime
  sentAt       DateTime?
  createdAt    DateTime           @default(now())

  user       User                @relation(fields: [userId], references: [id])
  membership Membership?         @relation(fields: [membershipId], references: [id])
  trigger    NotificationTrigger @relation(fields: [triggerId], references: [id])

  @@index([triggerAt, status])
  @@index([userId])
  @@index([membershipId])
}

model NotificationTrigger {
  id              String       @id @default(uuid())
  name            String
  triggerEvent    TriggerEvent
  offsetDays      Int
  messageTemplate String
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  notificationJobs NotificationJob[]

  @@index([triggerEvent])
  @@index([isActive])
}
